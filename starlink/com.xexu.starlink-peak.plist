<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.xexu.starlink-peak</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/xexu/dev/dotfiles/starlink/peak-test.sh</string>
    </array>
    <!-- Dos medidas en hora punta y una de madrugada. La de las 03:00 no sobra: sin un
         punto con la celda vacia, las otras dos no se comparan con nada. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>21</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>22</integer>
            <key>Minute</key>
            <integer>45</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>3</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/tmp/starlink-peak.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/starlink-peak.err.log</string>
</dict>
</plist>
